{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zeerats/laravel-lang-lint",
    "description": "Artisan commands that lint Laravel language files: missing keys, unused keys and consistent formatting.",
    "keywords": [
        "laravel",
        "translations",
        "localization",
        "i18n",
        "lang",
        "lint",
        "artisan"
    ],
    "homepage": "https://github.com/zeerats/laravel-lang-lint",
    "license": "MIT",
    "authors": [
        {
            "name": "zeerats",
            "homepage": "https://github.com/zeerats"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/collections": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "symfony/finder": "^7.2||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Zeerats\\LangLint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeerats\\LangLint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --parallel",
        "lint:check": "vendor/bin/pint --parallel --test",
        "analyse": "vendor/bin/phpstan analyse",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest --parallel",
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zeerats\\LangLint\\LangLintServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
